# Application
APP_NAME=CareerPilot AI
APP_VERSION=0.1.0
APP_ENV=development
APP_SECRET_KEY=change-me-in-local-dev-only-minimum-32-chars
DEBUG=false

# Database (External managed PostgreSQL recommended; supports ?sslmode=require)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/careerpilot
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Redis (External managed Redis; supports redis:// and rediss://)
REDIS_URL=redis://localhost:6379/0

# ChromaDB (External/Cloud or self-hosted HTTP endpoint; semantic retrieval only)
CHROMA_URL=http://localhost:8001
CHROMA_API_KEY=
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_TOKENS=2048

# Adzuna
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Google OAuth 2.0 / OIDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Session & Auth
SESSION_TTL_SECONDS=604800
OAUTH_STATE_TTL_SECONDS=600
SESSION_COOKIE_NAME=careerpilot_session
SESSION_COOKIE_SECURE=false
DEV_AUTH_ENABLED=false

# Storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=
LOCAL_STORAGE_PATH=./storage

# Frontend & CORS
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Monitoring
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30

# Application
APP_NAME=JobMate AI
APP_VERSION=0.1.0
APP_ENV=development
APP_SECRET_KEY=change-me-in-local-dev-only-minimum-32-chars
DEBUG=false

# Database (External managed PostgreSQL recommended; supports ?sslmode=require)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/careerpilot
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Redis (External managed Redis; supports redis:// and rediss://)
REDIS_URL=redis://localhost:6379/0

# ChromaDB (External/Cloud or self-hosted HTTP endpoint; semantic retrieval only)
CHROMA_URL=http://localhost:8001
CHROMA_API_KEY=
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database

# LLM Provider Mode ("openai" | "claude")
LLM_MODE=openai

# OpenAI (LLM intelligence, embeddings, and web-search job discovery)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=90
OPENAI_MAX_TOKENS=4096

# Anthropic Claude (alternative LLM intelligence, tool calling, JSON, and web search)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_TIMEOUT_SECONDS=90
CLAUDE_MAX_TOKENS=4096

# Google OAuth 2.0 / OIDC
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://jobmateapi.techcreed.in/api/v1/auth/google/callback

# Session & Auth
SESSION_TTL_SECONDS=604800
OAUTH_STATE_TTL_SECONDS=600
SESSION_COOKIE_NAME=jobmate_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
DEV_AUTH_ENABLED=false

# Storage
STORAGE_PROVIDER=local
STORAGE_BUCKET=
LOCAL_STORAGE_PATH=./storage
MAX_RESUME_SIZE_BYTES=5242880
MAX_RESUME_PAGES=15

# Frontend & CORS
VITE_API_BASE_URL=https://jobmateapi.techcreed.in/api/v1
FRONTEND_URL=https://jobmate.techcreed.in
CORS_ALLOWED_ORIGINS=https://jobmate.techcreed.in,http://localhost:5173,http://127.0.0.1:5173,http://localhost:33340

# Monitoring
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30
